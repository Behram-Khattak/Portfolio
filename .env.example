# Runtime connection: least-privilege user (SELECT/INSERT/UPDATE/DELETE only)
DATABASE_URL=mysql://portfolio_app:CHANGE_ME@127.0.0.1:3306/portfolio
# Used only by drizzle-kit migrations and the seed script (needs DDL rights)
DATABASE_MIGRATE_URL=mysql://root@127.0.0.1:3306/portfolio
# 32+ random characters: openssl rand -hex 32
NUXT_SESSION_PASSWORD=
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
